{
  "cmi_db_path": {
    "description": "CMI SQLite 数据库路径",
    "type": "string",
    "default": "E:\\C418\\plugins\\CMI\\cmi.sqlite.db",
    "hint": "线上服务器上的 CMI 数据库路径。本地开发时如果该路径不存在，会尝试同名 .db 文件，并回退到插件目录下的 cmi.sqlite.db。"
  },
  "ack_emoji_enabled": {
    "description": "收到查询时表情回应",
    "type": "bool",
    "default": true
  },
  "ack_emoji_id": {
    "description": "表情回应 ID",
    "type": "string",
    "default": "124",
    "hint": "NapCat set_msg_emoji_like 使用的 emoji_id。"
  },
  "forward_sender_name": {
    "description": "合并转发显示名称",
    "type": "string",
    "default": "C418 查询助手"
  },
  "server_status_name": {
    "description": "服务器显示名称",
    "type": "string",
    "default": "C418"
  },
  "server_status_host": {
    "description": "服务器地址",
    "type": "string",
    "default": "127.0.0.1",
    "hint": "Minecraft Java 服务器地址，可以填写域名或 IP。"
  },
  "server_status_port": {
    "description": "服务器端口",
    "type": "int",
    "default": 25565,
    "slider": {"min": 1, "max": 65535, "step": 1}
  },
  "server_status_timeout_seconds": {
    "description": "状态查询超时秒数",
    "type": "float",
    "default": 3.0,
    "slider": {"min": 1, "max": 10, "step": 0.5}
  },
  "server_status_show_sample_players": {
    "description": "显示服务器返回的玩家样本",
    "type": "bool",
    "default": true,
    "hint": "只显示 Minecraft status 协议返回的 sample 玩家名，不读取 CMI 数据库。"
  },
  "default_rank_limit": {
    "description": "排行榜默认数量",
    "type": "int",
    "default": 10,
    "slider": {"min": 3, "max": 30, "step": 1}
  },
  "max_rank_limit": {
    "description": "排行榜最大数量",
    "type": "int",
    "default": 20,
    "slider": {"min": 5, "max": 50, "step": 1}
  }
}
